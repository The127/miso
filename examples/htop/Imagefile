# A Debian sid disk with htop in it, booted and checked before it is written.
#
#   miso build -o out examples/htop
#
# leaves out/os.raw, a GPT disk that boots under UEFI.

FROM debian:sid
RUN apt-get update && apt-get install -y --no-install-recommends systemd-boot-efi htop

# The cloud image's fstab names the cloud image's partitions, which the new
# disk does not have. The root partition has the root type, so the initrd
# finds it and the command line needs no root=.
RUN : > /etc/fstab && \
    mkdir -p /etc/kernel && \
    printf 'rw console=ttyS0\n' > /etc/kernel/cmdline

# The layout of the disk, in repart's own settings. It stays out of the image.
PARTITION esp Type=esp Format=vfat CopyFiles=/efi:/ SizeMinBytes=256M SizeMaxBytes=256M
PARTITION root Type=root Format=ext4 CopyFiles=/:/ SizeMinBytes=3G

OUTPUT disk os.raw

# Boots the disk and runs in it. A failing check fails the build and leaves
# no disk.
CHECK command -v htop
